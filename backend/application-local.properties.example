# Copy these non-secret settings into src/main/resources/application-local.properties.
# From backend/, start the API with:
# ./mvnw spring-boot:run -Dspring-boot.run.profiles=local \
#   -Dspring-boot.run.arguments="--spring.config.additional-location=file:./src/main/resources/application-local.properties"
spring.datasource.url=${LOCAL_DATABASE_URL:jdbc:postgresql://localhost:5432/career_assistant}
spring.datasource.username=${LOCAL_DATABASE_USERNAME:postgres}
spring.datasource.password=${LOCAL_DATABASE_PASSWORD:}
spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=true
career.resume.storage=supabase
career.resume.supabase.url=${SUPABASE_URL}
career.resume.supabase.service-role-key=${SUPABASE_SERVICE_ROLE_KEY}
career.resume.supabase.bucket=${SUPABASE_RESUME_BUCKET:resumes}
