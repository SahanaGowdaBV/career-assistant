# Required Railway/Spring configuration. Replace blank values in the platform UI.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
SUPABASE_AUTH_ISSUER=
SUPABASE_AUTH_JWKS_URI=
APP_ALLOWED_EMAILS=
